Package: cqtkit
Title: Comprehensive C-QT Analysis From Data to Deliverables
Version: 2.0.0
Authors@R: c(
    person("Matt", "Smith", , "matthews@a2-ai.com", role = c("aut", "cre")),
    person("Devin", "Pastoor", , "devin@a2-ai.com", role = c("aut")),
